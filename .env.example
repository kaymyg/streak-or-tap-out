# Copy to .env and fill in. scripts/deploy.ts writes a local one for you.
# Never commit a real key.

# ---------------------------------------------------------------- local dev
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
DAILYTAP_ADDR=
STREAK_ADDR=
VERIFIER_PK=
SIWE_DOMAIN=localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
PORT=8787
# Unset = in-process state. Fine locally, wrong with more than one instance.
# REDIS_URL=redis://127.0.0.1:6379


# ------------------------------------------------- production: the verifier
# Runs on a host that keeps a process alive (Railway, Render, Fly). NOT on
# Vercel functions as written — they are stateless and scale to several
# instances, and a round opened on one would be invisible to the others.
#
# RPC_URL=https://sepolia.base.org
# CHAIN_ID=84532
# DAILYTAP_ADDR=0x...
# STREAK_ADDR=0x...
# VERIFIER_PK=0x...          separate key, holds no funds, only signs
# REDIS_URL=rediss://...     required in production
#
# SIWE_DOMAIN must match the host the page is served from, exactly. It is what
# the wallet displays at sign-in, and a mismatch is a 401 that looks like a
# signature problem. Pin it here rather than reading req.hostname, which drifts
# behind a proxy.
# SIWE_DOMAIN=streakortapout.fun
# ALLOWED_ORIGINS=https://streakortapout.fun,https://www.streakortapout.fun


# ----------------------------------------------------- production: the page
# Static files on Vercel at streakortapout.fun. Set this before building so
# web/deployed.json points the page at the verifier's real host; otherwise the
# deployed site calls the visitor's own machine on localhost.
#
# API_BASE=https://api.streakortapout.fun
